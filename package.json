{
  "name": "grafit-strona",
  "version": "1.0.0",
  "private": true,
  "description": "Narzędzia deweloperskie strony grafit-fitness.pl (testy dostępności). Nie są publikowane.",
  "scripts": {
    "test": "playwright test",
    "test:nvda": "playwright test -c testy/nvda/playwright.config.js",
    "test:html": "html-validate index.html",
    "test:lighthouse": "lhci autorun",
    "test:pa11y": "pa11y-ci --config .pa11yci.js --sitemap https://grafit-fitness.pl/sitemap.xml",
    "test:wszystko": "npm run test:html && npm test && npm run test:lighthouse"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14",
    "@guidepup/playwright": "^0.21.0",
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "^1.65.1",
    "@siteimprove/alfa-act": "0.120.0",
    "@siteimprove/alfa-playwright": "0.84.3",
    "@siteimprove/alfa-rules": "0.120.0",
    "accessibility-checker": "4.0.34",
    "apca-w3": "0.1.9",
    "axe-html-reporter": "2.2.11",
    "html-validate": "11.19.0",
    "monocart-reporter": "2.15.1",
    "pa11y-ci": "5.0.0",
    "serve": "^14.2.8"
  },
  "overrides": {
    "basic-ftp": "6.2.6"
  }
}
